      <aliases enabled='yes' />
      <column caption='Review performace score' datatype='integer' name='[Calculation_1391206963085312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]* [Review Scores Rating]' />
      </column>
      <column caption='Propoties By Category ' datatype='string' name='[Calculation_1391206965293057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 300 THEN &quot;Luxury&quot; ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot; ELSE &quot;Budget&quot; END' />
      </column>
      <column caption='Customer Review' datatype='string' name='[Calculation_1391206966681602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Number Of Reviews] &gt; 100 THEN &quot;Highly Reviewed&quot; ELSE &quot;less Reviewed&quot; END' />
      </column>
      <column caption='Avalablity Status' datatype='string' name='[Calculation_1391206967660547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Host Since] &lt;= DATE(&quot;2009-01-01&quot;) THEN &quot;Active Host&quot; ELSE &quot; New Host&quot; END' />
      </column>
      <column caption='Price by beds' datatype='integer' name='[Calculation_1391206969212932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price] * [Beds]' />
      </column>
      <column caption='Review Scores ' datatype='string' name='[Calculation_1391206969651205]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Review Scores Rating] &gt;= 90 THEN &quot;Excellent&quot; ELSEIF [Review Scores Rating] &gt; 70 THEN &quot; Good&quot; ELSEIF  [Review Scores Rating] &gt;= 50 THEN &quot; Average &quot; ELSE &quot;poor&quot; END' />
      </column>
      <column caption='Expensive Properties' datatype='string' name='[Calculation_1391206971379718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;=200 THEN &quot;Expensive&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1391206976581642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1391206976126985] THEN &quot; Above Limit &quot; ELSE &quot; Below Limit&quot; END' />
      </column>
      <column caption='Review Score rating on beds' datatype='string' name='[Calculation_1391206978736141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Review Scores Rating] &gt;=  [Parameters].[Parameter 1391206977921035] AND [Beds] &gt;= [Parameters].[Parameter 1391206978473996] THEN &quot;Selected &quot; ELSE &quot; Not Selected &quot; end' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
